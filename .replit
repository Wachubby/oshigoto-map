run = "npm run dev"
modules = ["nodejs-24"]
[deployment]
build = ["sh", "-c", "npm ci --include=dev --no-audit --no-fund && npm run build"]
run = ["npm", "start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80
[nix]
channel = "stable-24_05"
packages = ["nodejs_22"]
[env]
NODE_ENV = "production"
HOST = "0.0.0.0"
HOSTNAME = "0.0.0.0"
NODE_OPTIONS = "--no-network-family-autoselection"

[userenv]

[userenv.shared]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
